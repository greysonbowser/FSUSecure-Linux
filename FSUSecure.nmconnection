[connection]
id=FSUSecure
uuid=b5441703-8410-4eb1-8e6f-40fedfb49d70
type=wifi
interface-name=wlan0

[wifi]
mode=infrastructure
ssid=FSUSecure

[wifi-security]
key-mgmt=wpa-eap

[802-1x]
eap=peap;
identity=abc123@fsu.edu
password=YourPassword
phase2-auth=mschapv2

[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=auto

[proxy]
